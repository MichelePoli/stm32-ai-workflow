# Dockerfile.triton
# Custom Triton image with vLLM + sentence-transformers support
# Using 24.08 which ships with PyTorch 2.4+ and vLLM 0.5.3+
FROM nvcr.io/nvidia/tritonserver:24.08-py3

# Fix ASCII codec issues in Python backend stubs
ENV PYTHONIOENCODING=utf-8
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Install system deps
RUN apt-get update && apt-get install -y \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python ML dependencies (PyTorch 2.4+ already in base image)
RUN pip3 install --no-cache-dir \
    vllm==0.6.3.post1 \
    numpy \
    sentence-transformers==3.3.1 \
    einops \
    accelerate

# Standard Triton ports
EXPOSE 8000 8001 8002

# Entrypoint from base image, commands via docker-compose
